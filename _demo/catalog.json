        },
        {
          "type": "release",
          "request": "rename-2"
        },
        {
          "type": "release",
          "request": "rename-1"
        }
      ],
      "actions": [
        {
          "type": "click",
          "target": "rename-weekend"
        },
        {
          "type": "click",
          "target": "rename-launch"
        },
        {
