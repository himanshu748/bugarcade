    {
      "id": "lost-note",
      "title": "The vanishing note",
      "subtitle": "A save that takes more than it gives.",
      "category": "Stale state",
      "difficulty": "Warm-up",
      "goal": "Make Papertrail lose your new note in three moves.",
      "hint": "A sync takes a snapshot. What happens if you keep writing before it finishes?",
      "explanation": "Sync captures the current notes array. Its delayed acknowledgement replaces state with that old snapshot, deleting notes added while the request was pending. The fix treats the response as an acknowledgement and keeps newer local state; appends use a functional state update.",
      "accent": "lime",
      "targetMoves": 3,
      "allowedTargets": [
        "sync",
        "add-note",
        "draft",
        "notes",
        "sync-state"
      ],
      "initialActions": [
        {
          "type": "fill",
          "target": "draft",
          "value": "Book the demo slot"
        },
        {
          "type": "click",
          "target": "sync"
        },
        {
          "type": "click",
          "target": "add-note"
        },
        {
          "type": "release",
          "request": "save-1"
        }
      ],
      "actions": [
        {
          "type": "click",
          "target": "sync"
        },
        {
          "type": "click",
          "target": "add-note"
        },
        {
          "type": "release",
          "request": "save-1"
        }
      ],
      "assertion": {
        "target": "notes",
        "operator": "contains",
        "expected": "Book the demo slot"
      },
      "completion": {
        "target": "sync-state",
        "value": "Synced · 1 added"
      },
      "schedule": [
        {
          "id": "save-1",
          "key": "save",
          "status": 200,
          "response": {
            "saved": true
          }
        }
      ],
      "seed": 0
    },
    {
      "id": "rollback",
      "title": "The undo from the past",
      "subtitle": "Yesterday's failure. Today's damage.",
      "category": "Optimistic rollback",
      "difficulty": "Tricky",
      "goal": "Make a failed rename undo a newer, successful rename.",
      "hint": "Make two changes. Let the newer one succeed before the older one fails.",
      "explanation": "Each rename captures a previous title. An older request failing after a newer success rolls the board back unconditionally. The fixed version assigns each mutation a revision and only rolls back if it still owns the current state.",
      "accent": "orange",
      "targetMoves": 4,
      "allowedTargets": [
        "rename-weekend",
        "rename-launch",
        "board-title",
        "rename-state"
