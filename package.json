{
  "name": "bugarcade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:fixtures": "node worker/server.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint frontend fixtures worker scripts --max-warnings 0",
    "test:worker": "node --test tests/worker.test.mjs",
    "verify:seeds": "node scripts/verify-seeds.mjs",
    "test:e2e": "playwright test",
    "start": "node scripts/start.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "eslint": "9.39.1",
    "typescript-eslint": "8.46.3"
  }
}
